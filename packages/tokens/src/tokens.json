{
  "meta": {
    "name": "ONCI Design Tokens",
    "version": "0.3.2",
    "source": "wp-onci/theme.json + component styles + ONCI brand decisions",
    "method": "primitive -> semantic -> component"
  },
  "color": {
    "base": "#FFFFFF",
    "contrast": "#000000",
    "muted": "#6B7280",
    "surface": "#F5F5F5",
    "surfaceDark": "#1A1A1A",
    "border": "#E5E7EB",
    "red": "#D71920",
    "redDark": "#A80F15",
    "blue": "#1255A6",
    "blueDark": "#0B3468",
    "yellow": "#F2B705",
    "orange": "#E86A17",
    "earth": "#8C3B20",
    "success": "#138A4B",
    "warning": "#B86500",
    "danger": "#D71920"
  },
  "spacing": {
    "2xs": "0.25rem",
    "xs": "0.5rem",
    "sm": "0.75rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem",
    "3xl": "4rem",
    "4xl": "6rem"
  },
  "fontSize": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "md": "1rem",
    "lg": "1.125rem",
    "xl": "1.5rem",
    "2xl": "2.25rem",
    "3xl": "clamp(2.5rem, 5vw, 4.5rem)",
    "display": "clamp(3.5rem, 8vw, 8rem)"
  },
  "fontFamily": {
    "primary": "'Nunito Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "brand": "'1797', 'Arial Black', sans-serif",
    "mono": "'SFMono-Regular', Consolas, 'Liberation Mono', monospace"
  },
  "layout": {
    "content": "1200px",
    "wide": "1400px",
    "reading": "760px",
    "sidebar": "272px"
  },
  "radius": {
    "none": "0",
    "sm": "2px",
    "md": "4px",
    "pill": "999px"
  },
  "borderWidth": {
    "hairline": "1px",
    "strong": "2px",
    "emphasis": "3px"
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "320ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "primitive": {
    "color": {
      "white": "#FFFFFF",
      "black": "#000000",
      "gray100": "#F5F5F5",
      "gray200": "#E5E7EB",
      "gray600": "#6B7280",
      "gray900": "#1A1A1A",
      "red500": "#D71920",
      "red700": "#A80F15",
      "blue500": "#1255A6",
      "blue700": "#0B3468",
      "yellow500": "#F2B705",
      "orange500": "#E86A17",
      "earth500": "#8C3B20",
      "green600": "#138A4B",
      "amber700": "#B86500"
    },
    "space": {
      "4": "0.25rem",
      "8": "0.5rem",
      "12": "0.75rem",
      "16": "1rem",
      "24": "1.5rem",
      "32": "2rem",
      "48": "3rem",
      "64": "4rem",
      "96": "6rem"
    },
    "radius": {
      "0": "0",
      "2": "2px",
      "4": "4px",
      "full": "999px"
    },
    "border": {
      "1": "1px",
      "2": "2px",
      "3": "3px"
    },
    "motion": {
      "120": "120ms",
      "140": "140ms",
      "160": "160ms",
      "180": "180ms",
      "220": "220ms",
      "320": "320ms",
      "400": "400ms",
      "easeStandard": "cubic-bezier(0.2, 0, 0, 1)",
      "easeNavigation": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "size": {
      "touch44": "44px",
      "touch48": "48px",
      "control52": "52px",
      "navigation64": "64px",
      "filterHeader72": "72px"
    }
  },
  "semantic": {
    "color": {
      "background": {
        "canvas": "{primitive.color.white}",
        "surface": "{primitive.color.gray100}",
        "inverse": "{primitive.color.black}",
        "darkSurface": "{primitive.color.gray900}"
      },
      "text": {
        "primary": "{primitive.color.black}",
        "inverse": "{primitive.color.white}",
        "muted": "{primitive.color.gray600}"
      },
      "border": {
        "default": "{primitive.color.gray200}",
        "strong": "{primitive.color.black}"
      },
      "action": {
        "primary": "{primitive.color.red500}",
        "primaryHover": "{primitive.color.red700}",
        "secondary": "{primitive.color.black}"
      },
      "feedback": {
        "success": "{primitive.color.green600}",
        "warning": "{primitive.color.amber700}",
        "danger": "{primitive.color.red500}"
      }
    },
    "layout": {
      "content": "1200px",
      "wide": "1400px",
      "reading": "760px"
    },
    "breakpoint": {
      "mobile": "767px",
      "wpCompact": "782px",
      "tablet": "1024px",
      "navCompact": "1180px"
    },
    "motion": {
      "instant": "120ms ease",
      "feedback": "140ms ease",
      "control": "160ms ease",
      "drawer": "220ms ease",
      "media": "320ms ease",
      "story": "400ms ease",
      "navigation": "220ms cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "focus": {
      "width": "3px",
      "color": "{primitive.color.red500}",
      "offset": "3px"
    },
    "shadow": {
      "none": "none",
      "drawer": "-8px 0 30px rgb(0 0 0 / 0.12)"
    },
    "overlay": {
      "filter": "rgb(0 0 0 / 0.45)",
      "gallery": "rgb(0 0 0 / 0.62)"
    }
  },
  "component": {
    "button": {
      "height": "52px",
      "radius": "{primitive.radius.0}",
      "paddingX": "24px",
      "paddingY": "12px",
      "iconGap": "0.5em",
      "fontFamily": "{fontFamily.brand}",
      "fontWeight": "500",
      "fontStyle": "italic",
      "textTransform": "uppercase",
      "fontVariation": "{fontVariant.brand.italic}"
    },
    "field": {
      "height": "44px",
      "radius": "{primitive.radius.0}",
      "paddingX": "12px",
      "border": "1px solid #B7B7B7",
      "labelGap": "4px"
    },
    "form": {
      "fieldGap": "8px",
      "groupGap": "10px",
      "sectionGap": "20px",
      "sectionPadding": "14px"
    },
    "navigation": {
      "height": "64px",
      "itemMinWidth": "104px",
      "itemPaddingX": "20px",
      "indicatorHeight": "3px",
      "indicatorMotion": "140ms ease",
      "panelMotion": "120ms ease",
      "mobileMotion": "220ms cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "filterDrawer": {
      "width": "480px",
      "headerHeight": "72px",
      "controlTarget": "44px",
      "applyHeight": "52px",
      "overlayOpacity": "0.45",
      "motion": "220ms ease",
      "shadow": "{semantic.shadow.drawer}"
    },
    "productGallery": {
      "columnsDesktop": 2,
      "columnsTablet": 2,
      "columnsMobile": 1,
      "gap": "4px",
      "hoverScale": 1.075,
      "hoverMotion": "320ms ease",
      "toolbarTarget": "44px",
      "navTarget": "52px"
    },
    "slides": {
      "height": "640px",
      "mobileHeight": "100vw",
      "transition": "400ms ease",
      "inactiveOpacity": 0.45,
      "arrowTarget": "44px",
      "dotSize": "10px",
      "dotInactiveOpacity": 0.35
    }
  },
  "fontVariant": {
    "brand": {
      "medium": {
        "family": "{fontFamily.brand}",
        "name": "Medium",
        "fontWeight": "500",
        "fontStyle": "normal",
        "role": "Textos curtos de marca, subtítulos e composições que pedem presença com leitura estável.",
        "asset": "/1797_MEDIUM.ttf"
      },
      "italic": {
        "family": "{fontFamily.brand}",
        "name": "Italic",
        "fontWeight": "500",
        "fontStyle": "italic",
        "role": "Chamadas esportivas, ações, títulos de energia e situações em que movimento faz parte da mensagem.",
        "asset": "/1797_ITALIC.ttf"
      },
      "poster": {
        "family": "{fontFamily.brand}",
        "name": "Poster",
        "fontWeight": "400",
        "fontStyle": "normal",
        "role": "Títulos grandes, campanhas, números e composições editoriais de alto impacto.",
        "asset": "/1797_POSTER.ttf"
      }
    }
  }
}
