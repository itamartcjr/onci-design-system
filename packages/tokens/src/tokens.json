{
  "meta": {
    "name": "ONCI Design Tokens",
    "version": "0.1.0",
    "source": "wp-onci/theme.json + ONCI brand decisions"
  },
  "color": {
    "base": "#FFFFFF",
    "contrast": "#000000",
    "muted": "#6B7280",
    "surface": "#F5F5F5",
    "surfaceDark": "#1A1A1A",
    "border": "#E5E7EB",
    "red": "#D71920",
    "redDark": "#A80F15",
    "blue": "#1255A6",
    "blueDark": "#0B3468",
    "yellow": "#F2B705",
    "orange": "#E86A17",
    "earth": "#8C3B20",
    "success": "#138A4B",
    "warning": "#B86500",
    "danger": "#D71920"
  },
  "spacing": {
    "2xs": "0.25rem",
    "xs": "0.5rem",
    "sm": "0.75rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem",
    "3xl": "4rem",
    "4xl": "6rem"
  },
  "fontSize": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "md": "1rem",
    "lg": "1.125rem",
    "xl": "1.5rem",
    "2xl": "2.25rem",
    "3xl": "clamp(2.5rem, 5vw, 4.5rem)",
    "display": "clamp(3.5rem, 8vw, 8rem)"
  },
  "fontFamily": {
    "primary": "'Nunito Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "brand": "'1797', 'Arial Black', sans-serif",
    "mono": "'SFMono-Regular', Consolas, 'Liberation Mono', monospace"
  },
  "layout": {
    "content": "1200px",
    "wide": "1400px",
    "reading": "760px",
    "sidebar": "272px"
  },
  "radius": {
    "none": "0",
    "sm": "2px",
    "md": "4px",
    "pill": "999px"
  },
  "borderWidth": {
    "hairline": "1px",
    "strong": "2px",
    "emphasis": "3px"
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "320ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)"
  }
}
